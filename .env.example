# Copia este fichero a .env y rellena lo que necesites. .env está en .gitignore.

# Token de Hugging Face (solo hace falta para modelos con acceso restringido)
HF_TOKEN=

# Dónde guardar los modelos descargados. En la DGX conviene apuntar a un disco compartido.
HF_HOME=./hf_cache

# Qué GPUs ve el proceso. En la DGX NO lo toquéis: SLURM lo fija a la partición que os asigna.
# Solo tiene sentido en una máquina propia con varias GPUs, por ejemplo "0" o "2,3".
# CUDA_VISIBLE_DEVICES=0

# Puerto de la API
ARCA_API_PORT=8000

# Fase 1: adaptador entrenado que sirve /reasoning, y verificador (meddra es el de nuestro dominio)
# ARCA_RLM_ADAPTER=rlm/weights/final_rlm_lora
ARCA_RLM_VERIFIER=meddra

# Carpeta MedAscii de la distribución oficial de MedDRA, si tenéis licencia. Sin ella se usa el
# subconjunto de 90 PT incluido en rlm/meddra.py.
# ARCA_MEDDRA_DIR=/ruta/a/MedDRA/MedAscii
